{
  "name": "halden-shop",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Halden Outfitters: an outdoor-gear web shop with real business rules and planted bugs, built as a test target for QA.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "npm run build -w @halden/api && npm run build -w @halden/web && npm run build -w @halden/admin",
    "test": "npm run test -w @halden/money -w @halden/api",
    "test:e2e": "npm run test:e2e -w @halden/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w @halden/api",
    "db:seed": "npm run db:seed -w @halden/api",
    "db:reset": "npm run db:reset -w @halden/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "^10.13.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.0"
  }
}
