# Halden v2 API settings. Copy to apps/api/.env for local development.

# Local: the Docker Postgres from the Propmaster repo (port 5433). On Vercel: Neon's *pooled* connection string.
DATABASE_URL=postgres://propmaster:propmaster@localhost:5433/halden_v2
# The test suite drops and rebuilds this database. Never point it at real data.
TEST_DATABASE_URL=postgres://propmaster:propmaster@localhost:5433/halden_test

# Where the web app runs; used for links in emails and as the allowed Origin.
APP_URL=http://localhost:3001
PORT=4000
LOG_LEVEL=info

# Passwords for the seeded demo accounts (staff and shoppers). Never commit real values.
SEED_ADMIN_PASSWORD=
# Support and warehouse. Must differ from the admin password, so a support login can't open the admin account.
SEED_STAFF_PASSWORD=
SEED_SHOPPER_PASSWORD=
