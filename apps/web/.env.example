# Halden shop settings. Copy to apps/web/.env.local for local development; on Vercel, set them on the project.

# Where the API runs; /api/v1/* on this site is forwarded there.
API_URL=http://127.0.0.1:4000
# The staff admin (apps/admin): the "Staff admin" link and the /staff and /qa redirects go there. Read at build time.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
