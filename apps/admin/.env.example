# Halden admin settings. Copy to apps/admin/.env.local for local development; on Vercel, set them on the project.

# Where the API runs; /api/v1/* on this site is forwarded there.
API_URL=http://127.0.0.1:4000
# The shop's site, for links that open a shop page (a reviewed product, the fake inbox). Read at build time.
NEXT_PUBLIC_SHOP_URL=http://localhost:3001
