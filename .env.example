# The shop's database. Locally: the Docker Postgres from the Propmaster repo (port 5433).
# On Vercel with Neon: use Neon's *pooled* connection string here.
DATABASE_URL=postgres://propmaster:propmaster@localhost:5433/halden

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Passwords for the demo accounts created by `npm run db:setup` (see README).
SEED_ADMIN_PASSWORD=
SEED_SHOPPER_PASSWORD=
